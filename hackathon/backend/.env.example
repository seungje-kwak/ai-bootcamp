# Copy to backend/.env and fill in. Never commit .env (11.3).
# SUPABASE_* are required: the backend does not start without them.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# LLM: gemini (default) or claude. Leave LLM_API_KEY empty to use the rule-based planner (10.8).
LLM_PROVIDER=gemini
LLM_API_KEY=
# Empty = gemini-3.1-flash-lite for gemini, claude-opus-5-5 for claude
LLM_MODEL=
ALLOWED_ORIGINS=http://localhost:3000
REQUIRE_VERIFIED=false
LLM_FALLBACK_RULES=true
