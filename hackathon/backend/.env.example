# Copy to backend/.env and fill in. Never commit .env (11.3).
# Leave SUPABASE_* empty to use the local JSON store (backend/local_db.json).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Leave LLM_API_KEY empty to use the rule-based planner (10.8).
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
ALLOWED_ORIGINS=http://localhost:3000
REQUIRE_VERIFIED=false
LLM_FALLBACK_RULES=true
