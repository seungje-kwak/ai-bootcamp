NEXT_PUBLIC_API_URL=http://localhost:8000

# Kakao Maps JavaScript key (PRD 7.9). Empty = fallback SVG map. Register localhost:3000 and the Vercel URL as Web domains.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ---------------------------------------------------------------------------
# Optional server-only integrations. These are read by app/api/* route handlers.
# Never give them a NEXT_PUBLIC_ prefix: that would ship the key to the browser.
# ---------------------------------------------------------------------------

# Machine translation of free-form AI text for 简体中文 / 日本語 / 한국어 (app/api/translate).
# Empty = that text is shown in the original English with a "translation not connected" note.
# TRANSLATE_PROVIDER: deepl | google
TRANSLATE_PROVIDER=
TRANSLATE_API_KEY=

# Road distance and taxi fare for taxi legs (app/api/route-estimate, Kakao Mobility Directions API).
# Use the Kakao Developers REST API key, not the JavaScript key above.
# Empty = no taxi fare is shown anywhere.
KAKAO_REST_API_KEY=
