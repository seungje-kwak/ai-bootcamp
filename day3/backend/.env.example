# 복사해서 .env 로 만들고 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# Railway 에서는 이 파일 대신 Variables 탭에 같은 이름으로 넣습니다.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# 공공데이터포털 일반 인증키 (Decoding 키!). 아직 없으면 비워 두고 DATA_MODE=sample
PUBLIC_DATA_KEY=

# /collect 를 지키는 비밀번호 (아무 뜻 없는 긴 문자열)
ADMIN_TOKEN=change-me-to-a-long-random-string

# 이 API를 부를 수 있는 화면 주소 (쉼표로 구분, 끝에 / 없이)
# 로컬: 프론트를 127.0.0.1:5000 에서 열 때
# Railway Variables 에는 Vercel 주소: https://내프로젝트.vercel.app
FRONT_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# sample = 예시 파일 사용 / 이 줄을 지우면 진짜 관공서 API 호출
DATA_MODE=sample
